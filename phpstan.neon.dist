includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - theme
        - plugins
    excludePaths:
        - */vendor/*
        - */node_modules/*
        - */build/*
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
