{
  "name": "originalconcepts/oc-theme",
  "description": "Original Concepts WooCommerce theme and blocks — monorepo.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/woocommerce-stubs": "^8.9",
    "php-stubs/wordpress-stubs": "^6.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=3G",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "lint": "Run PHPCS over theme and plugins.",
    "lint:fix": "Auto-fix what PHPCBF can fix.",
    "analyse": "Static analysis with PHPStan + WordPress stubs.",
    "check": "Everything CI runs.",
    "test": "PHPUnit over the pure parts of the theme (no WordPress needed)."
  },
  "autoload-dev": {
    "psr-4": {
      "OC\\Tests\\": "tests/"
    }
  }
}
