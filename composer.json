{
  "name": "originalconcepts/oc-theme",
  "description": "Original Concepts WooCommerce theme and blocks — monorepo.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.5",
    "php-stubs/woocommerce-stubs": "^8.9",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "phpstan/phpstan": "^1.11"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "check": [
      "@lint",
      "@analyse"
    ]
  },
  "scripts-descriptions": {
    "lint": "Run PHPCS over theme and plugins.",
    "lint:fix": "Auto-fix what PHPCBF can fix.",
    "analyse": "Static analysis with PHPStan + WordPress stubs.",
    "check": "Everything CI runs."
  }
}
