msgstr "מה כבר פועל לפי הבחירה"

msgid "Google Analytics, Google Ads and Tag Manager — through Consent Mode v2."
msgstr "Google Analytics, Google Ads ו-Tag Manager - דרך Consent Mode v2."

msgid "configured"
msgstr "מוגדר"

msgid "not configured"
msgstr "לא מוגדר"

msgid "Meta pixel and TikTok pixel — loaded only with marketing consent; the Conversions APIs follow the same flag."
msgstr "פיקסל Meta ופיקסל TikTok - נטענים רק עם הסכמה לשיווק; ה-Conversions API פועל לפי אותו דגל."

msgid "Flashy — held back until marketing consent when its deferral is on in Settings → Marketing."
msgstr "Flashy - מעוכב עד להסכמה לשיווק כשהדחייה שלו פעילה בהגדרות ← שיווק."

msgid "WooCommerce cart and session cookies, sign-in — necessary, always on."
msgstr "עוגיות הסל וה-session של WooCommerce, התחברות - הכרחיות, תמיד פעילות."

